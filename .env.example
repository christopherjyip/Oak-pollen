# Pentair IntelliCenter Connection Settings
# Provide the IP address of your IntelliCenter on the local network
INTELLICENTER_HOST=
# WebSocket port (default 6680)
INTELLICENTER_PORT=6680

# Set to "true" to use demo/mock data (no real controller needed)
DEMO_MODE=true

# Weather Underground Integration (optional)
# Get an API key at https://www.wunderground.com/member/api-keys
WUNDERGROUND_API_KEY=
# Your PWS station ID (e.g., "KCASONOM123")
WUNDERGROUND_STATION_ID=
# Coordinates for forecast (near your pool)
WUNDERGROUND_LAT=
WUNDERGROUND_LON=

# Database path (defaults to ./data/pool-history.db)
# DB_PATH=/path/to/pool-history.db
