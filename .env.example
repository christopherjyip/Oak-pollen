# Pentair ScreenLogic Connection Settings
# Leave SCREENLOGIC_HOST empty to use auto-discovery on local network
SCREENLOGIC_HOST=
SCREENLOGIC_PORT=80

# For remote/cloud connection, provide the system name (e.g., "Pentair: xx-xx-xx")
SCREENLOGIC_SYSTEM_NAME=

# Optional: 4-digit password if your controller requires one
SCREENLOGIC_PASSWORD=

# Set to "true" to use demo/mock data (no real controller needed)
DEMO_MODE=true
